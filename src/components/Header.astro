---
// Header — navigazione principale
// Desktop: logo + nav orizzontale (Children’s, Editorial, Game Art, About, Contact)
// Mobile: hamburger + menu full-screen overlay

const navLinks = [
  { href: '/illustration/children', label: 'Children’s Illustration' },
  { href: '/illustration/editorial', label: 'Editorial Illustration' },
]
---

<header class="site-header" data-header>
  <div class="container site-header__inner">
    <a href="/" class="site-header__brand" aria-label="CinereaArt — Home">
      <span class="site-header__wordmark">Cinerea</span>
    </a>

    <!-- Navigazione desktop -->
    <nav class="site-nav" aria-label="Navigazione principale">
      <ul class="site-nav__list">
        <li class="site-nav__item">
          <a href="/illustration/children" class="site-nav__link">Children’s Illustration</a>
        </li>
        <li class="site-nav__item">
          <a href="/illustration/editorial" class="site-nav__link">Editorial Illustration</a>
        </li>
        <li class="site-nav__item">
          <a href="/game-art" class="site-nav__link">Game Art</a>
        </li>
        <li class="site-nav__item">
          <a href="/about" class="site-nav__link">About</a>
        </li>
        <li class="site-nav__item">
          <a href="/contact" class="site-nav__link">Contact</a>
        </li>
      </ul>
    </nav>

    <!-- Hamburger mobile -->
    <button class="site-header__toggle" data-menu-toggle aria-expanded="false" aria-controls="mobile-menu" aria-label="Open menu">
      <span class="site-header__toggle-bar"></span>
      <span class="site-header__toggle-bar"></span>
      <span class="site-header__toggle-bar"></span>
    </button>
  </div>

  <!-- Menu mobile overlay -->
  <div class="mobile-menu" id="mobile-menu" data-mobile-menu>
    <nav class="mobile-menu__nav" aria-label="Navigazione mobile">
      <ul class="mobile-menu__list">
        {navLinks.map((link) => (
          <li class="mobile-menu__item" key={link.href}>
            <a class="mobile-menu__link" href={link.href}>{link.label}</a>
          </li>
        ))}
        <li class="mobile-menu__item">
          <a class="mobile-menu__link" href="/game-art">Game Art</a>
        </li>
        <li class="mobile-menu__item">
          <a class="mobile-menu__link" href="/about">About</a>
        </li>
        <li class="mobile-menu__item">
          <a class="mobile-menu__link" href="/contact">Contact</a>
        </li>
      </ul>
      <div class="mobile-menu__social">
        <a href="https://www.instagram.com/cinerea__/" target="_blank" rel="noopener noreferrer">Instagram</a>
        <a href="https://www.behance.net/agnesefavilla" target="_blank" rel="noopener noreferrer">Behance</a>
      </div>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(250, 250, 248, 0.92);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--color-surface);
    height: var(--header-h-mobile);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
  }

  .site-header__wordmark {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: 0.01em;
  }

  /* ---------- Nav desktop ---------- */
  .site-nav {
    display: none;
  }

  /* ---------- Hamburger ---------- */
  .site-header__toggle {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    padding: 10px;
    background: transparent;
    border: none;
    cursor: pointer;
    z-index: 210;
  }

  .site-header__toggle-bar {
    display: block;
    width: 24px;
    height: 2px;
    background: var(--color-text);
    transition: all var(--transition-base);
  }

  /* Stato aperto hamburger → X */
  .site-header__toggle[aria-expanded='true'] .site-header__toggle-bar:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .site-header__toggle[aria-expanded='true'] .site-header__toggle-bar:nth-child(2) {
    opacity: 0;
  }
  .site-header__toggle[aria-expanded='true'] .site-header__toggle-bar:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* ---------- Menu mobile overlay ---------- */
  .mobile-menu {
    position: fixed;
    inset: 0;
    top: var(--header-h-mobile);
    background: var(--color-bg);
    transform: translateX(100%);
    transition: transform var(--transition-slow);
    z-index: 200;
    overflow-y: auto;
    padding: var(--space-5);
  }

  .mobile-menu.is-open {
    transform: translateX(0);
  }

  .mobile-menu__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .mobile-menu__group {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-top: var(--space-5);
    margin-bottom: var(--space-2);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--color-surface);
  }

  .mobile-menu__link {
    display: block;
    padding: var(--space-3) 0;
    font-size: 1.125rem;
    font-weight: 500;
  }

  .mobile-menu__social {
    display: flex;
    gap: var(--space-5);
    margin-top: var(--space-8);
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  /* ---------- Desktop ---------- */
  @media (min-width: 640px) {
    .site-header {
      height: var(--header-h);
    }

    .site-header__toggle {
      display: none;
    }

    .site-nav {
      display: block;
    }

    .site-nav__list {
      display: flex;
      align-items: center;
      gap: var(--space-5);
    }

    .site-nav__link {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      font-size: 0.9375rem;
      font-weight: 500;
      padding: var(--space-2) 0;
      position: relative;
    }

    .site-nav__link::after {
      content: '';
      position: absolute;
      bottom: 2px;
      left: 0;
      width: 0;
      height: 2px;
      background: var(--color-accent);
      transition: width var(--transition-base);
    }

    .site-nav__link:hover::after {
      width: 100%;
    }
  }
</style>

<script>
  // Menu mobile toggle
  const toggle = document.querySelector('[data-menu-toggle]');
  const menu = document.querySelector('[data-mobile-menu]');

  toggle.addEventListener('click', () => {
    const isOpen = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!isOpen));
    menu.classList.toggle('is-open', !isOpen);
    document.body.style.overflow = isOpen ? '' : 'hidden';
  });

  // Chiudi menu quando si clicca un link
  menu.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      toggle.setAttribute('aria-expanded', 'false');
      menu.classList.remove('is-open');
      document.body.style.overflow = '';
    });
  });

  // Chiudi con Escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      toggle.setAttribute('aria-expanded', 'false');
      menu.classList.remove('is-open');
      document.body.style.overflow = '';
    }
  });
</script>
