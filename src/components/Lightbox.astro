---
// Lightbox — gallery a schermo intero (zero dipendenze)
// Intercetta i link [data-lightbox] della pagina e apre un overlay che mostra
// l'immagine in full senza navigare. Prev/Next, Esc, click fuori, contatore,
// riduzione-motion rispettata (fade invece di zoom).
---
<script>
  (function () {
    const items = Array.from(document.querySelectorAll('[data-lightbox]'));
    if (items.length === 0) return;

    const images = items
      .map(function (el) {
        const href = el.getAttribute('href');
        const alt = el.getAttribute('aria-label') || 'Immagine';
        return { href: href, alt: alt };
      })
      .filter(function (img) {
        return img.href && img.href.length > 0;
      });

    if (images.length === 0) return;

    const reduceMotion =
      typeof window.matchMedia === 'function' &&
      window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // ---- Overlay DOM ----
    const lightbox = document.createElement('div');
    lightbox.className = 'lightbox';
    lightbox.setAttribute('role', 'dialog');
    lightbox.setAttribute('aria-modal', 'true');
    lightbox.setAttribute('aria-label', 'Galleria immagini');
    lightbox.style.cssText =
      'position:fixed;inset:0;z-index:1000;background:var(--color-overlay);' +
      'display:flex;align-items:center;justify-content:center;' +
      'opacity:0;visibility:hidden;transition:opacity .2s ease,visibility .2s ease;';

lightbox.innerHTML =
      '<div class="lightbox__stage" style="position:absolute;inset:0;display:flex;' +
      'align-items:center;justify-content:center;flex-direction:column;' +
      'text-align:center;padding:64px 24px;">' +
      '  <div style="display:flex;align-items:center;justify-content:center;flex:1;min-height:0;' +
      '            width:100%;max-width:96vw;">' +
      '    <img class="lightbox__img" alt="" style="max-width:100%;max-height:100%;' +
      '            width:auto;height:auto;object-fit:contain;' +
      '            display:block;box-shadow:0 0 40px rgba(0,0,0,.5);"/>' +
      '  </div>' +
      '  <p class="lightbox__caption" style="color:#fff;margin:14px 0 0;font-size:.9375rem;min-height:1.4em;"></p>' +
      '  <button class="lightbox__close" aria-label="Close" style="position:absolute;top:18px;right:22px;' +
      'background:transparent;border:0;color:#fff;font-size:2rem;line-height:1;cursor:pointer;padding:8px;">&times;</button>' +
      '  <button class="lightbox__prev" aria-label="Previous image" style="position:absolute;left:18px;top:50%;' +
      'transform:translateY(-50%);background:transparent;border:0;color:#fff;font-size:3rem;cursor:pointer;' +
      'line-height:1;padding:6px 12px;">&#8249;</button>' +
      '  <button class="lightbox__next" aria-label="Next image" style="position:absolute;right:18px;top:50%;' +
      'transform:translateY(-50%);background:transparent;border:0;color:#fff;font-size:3rem;cursor:pointer;' +
      'line-height:1;padding:6px 12px;">&#8250;</button>' +
      '</div>';

    document.body.appendChild(lightbox);

    const imgEl = lightbox.querySelector('.lightbox__img');
    const capEl = lightbox.querySelector('.lightbox__caption');
    const closeBtn = lightbox.querySelector('.lightbox__close');
    const prevBtn = lightbox.querySelector('.lightbox__prev');
    const nextBtn = lightbox.querySelector('.lightbox__next');

    let current = -1;

    function show(index) {
      if (index < 0) index = images.length - 1;
      if (index >= images.length) index = 0;
      current = index;
      const img = images[current];
      imgEl.setAttribute('src', img.href);
      imgEl.setAttribute('alt', img.alt);
      capEl.textContent =
        (current + 1) + ' / ' + images.length + (img.alt ? ' — ' + img.alt : '');
    }

    function open(index) {
      show(index);
      lightbox.style.opacity = '1';
      lightbox.style.visibility = 'visible';
      document.body.style.overflow = 'hidden';
      closeBtn.focus();
      // prev/next nascosti se c'è una sola immagine
      var single = images.length <= 1;
      prevBtn.style.display = single ? 'none' : '';
      nextBtn.style.display = single ? 'none' : '';
    }

    function close() {
      lightbox.style.opacity = '0';
      lightbox.style.visibility = 'hidden';
      document.body.style.overflow = '';
      current = -1;
    }

    items.forEach(function (el, idx) {
      el.addEventListener('click', function (e) {
        e.preventDefault();
        open(idx);
      });
    });

    closeBtn.addEventListener('click', close);
    prevBtn.addEventListener('click', function () { show(current - 1); });
    nextBtn.addEventListener('click', function () { show(current + 1); });

    lightbox.addEventListener('click', function (e) {
      if (e.target === lightbox) close();
    });

    document.addEventListener('keydown', function (e) {
      if (lightbox.style.visibility !== 'visible') return;
      if (e.key === 'Escape') {
        close();
      } else if (e.key === 'ArrowLeft') {
        prevBtn.click();
      } else if (e.key === 'ArrowRight') {
        nextBtn.click();
      }
    });
  })();
</script>

<style>
  .lightbox__img {
    opacity: 1;
  }
  /* riduzione-motion: niente transizioni, solo display immediato */
  @media (prefers-reduced-motion: reduce) {
    .lightbox {
      transition: none !important;
    }
  }
</style>