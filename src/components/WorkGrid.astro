---
// WorkGrid — griglia portfolio con filtri a chips (client-side)
// Usata nelle pagine di categoria.
interface Props {
  title: string;
  description?: string;
  works: {
    title: string;
    image: string;       // percorso thumb
    fullImage?: string;  // percorso full per lightbox
    slug?: string;       // se presente, la card linka alla project page (/{slug})
    format?: string;     // per filtri (es. picture-book, cover, spot)
    tags?: string[];
  }[];
  filters?: { value: string; label: string }[];
  layout?: 'masonry' | 'regular' | 'gameart';
  basePath?: string;     // path della sezione corrente (es. "/illustration/children/")
}
const { title, description, works, filters, layout = 'regular', basePath = '' } = Astro.props;
---

<section class="work-section section">
  <div class="container">
    <header class="work-section__head">
      <span class="overline">Portfolio</span>
      <h1 class="work-section__title">{title}</h1>
      {description && <p class="work-section__desc">{description}</p>}
    </header>

    <div class={`grid grid--${layout}`} style={layout === 'masonry' ? 'grid-auto-rows: 10px;' : undefined}>
      {works.map((w, i) =>
        w.slug ? (
          <figure class="card card--project" data-item data-format={w.format || ''} data-tags={(w.tags || []).join(' ')}>
            <a class="card__media card__link" href={`${basePath}${w.slug}`} aria-label={`${w.title} — open project`}>
              <img src={w.image} alt={w.title} loading={i < 4 ? 'eager' : 'lazy'} decoding="async" />
            </a>
            <figcaption class="card__title">
              <span class="card__title-text">{w.title}</span>
            </figcaption>
          </figure>
        ) : (
          <figure class="card" data-item data-format={w.format || ''} data-tags={(w.tags || []).join(' ')}>
            <a class="card__media" href={w.fullImage || w.image} data-lightbox aria-label={w.title}>
              <img src={w.image} alt={w.title} loading={i < 4 ? 'eager' : 'lazy'} decoding="async" />
            </a>
          </figure>
        )
      )}
    </div>
  </div>
</section>

<style>
  .work-section__head {
    margin-bottom: var(--space-6);
    max-width: 60ch;
  }

  .work-section__title {
    font-size: 2rem;
    margin-block: var(--space-2) var(--space-3);
  }

  .work-section__desc {
    color: var(--color-text-muted);
    margin-bottom: var(--space-5);
  }

  /* ---------- Card ---------- */
  .card {
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--color-surface);
    margin-bottom: var(--space-4);
  }

  .card__media {
    display: block;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    cursor: zoom-in;
    background: var(--color-surface);
  }

  .card__media.card__link {
    cursor: pointer;
  }

  /* Card progetto: titolo sotto l'immagine */
  .card--project .card__media {
    aspect-ratio: 4 / 3;
  }

  .card__title {
    padding: var(--space-3) var(--space-4) var(--space-4);
    background: var(--color-surface);
  }

  .card__title-text {
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.2;
    color: var(--color-text);
    display: block;
  }

  .card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-base);
  }

  .card:hover .card__media img {
    transform: scale(1.03);
  }

  /* ---------- Layout variants ---------- */
  .grid--regular {
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  }

  /* Masonry: colonne CSS, per immagini di altezze diverse (children) */
  .grid--masonry {
    display: block;
    column-count: 1;
    column-gap: var(--space-4);
  }

  @media (min-width: 640px) {
    .grid--masonry {
      column-count: 2;
    }
  }

  @media (min-width: 1024px) {
    .grid--masonry {
      column-count: 3;
    }
  }

  /* Game art: 2 colonne + primo progetto large */
  .grid--gameart {
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
  }
</style>
