---
// ProjectPage — layout per la pagina di un singolo lavoro/progetto
// Trovabile a /illustration/children/[slug], /illustration/editorial/[slug], /game-art/[slug]
interface Props {
  title: string;
  category: string;
  client?: string;
  year?: number;
  role?: string;
  description?: string;
  gallery: { src: string; alt: string }[];
}
const { title, category, client, year, role, description, gallery } = Astro.props;
---

<section class="section">
  <div class="container project">
    <nav class="project__back">
      <a href={`../`}>&larr; Back to {category}</a>
    </nav>

    <header class="project__head">
      <h1 class="project__title">{title}</h1>
      <ul class="project__meta">
        {client && <li><strong>Client:</strong> {client}</li>}
        {year && <li><strong>Year:</strong> {year}</li>}
        {role && <li><strong>Role:</strong> {role}</li>}
      </ul>
      {description && <p class="project__desc">{description}</p>}
    </header>

    <div class="project__gallery">
      {gallery.map((g, i) => (
        <figure class="project__shot" data-glightbox>
          <a href={g.src} data-lightbox aria-label={g.alt}>
            <img
              src={g.src}
              alt={g.alt}
              loading={i === 0 ? 'eager' : 'lazy'}
              decoding="async"
            />
          </a>
        </figure>
      ))}
    </div>

    <nav class="project__nav">
      <a class="btn" href="../">&larr; Previous</a>
      <a class="btn" href="../">Next &rarr;</a>
    </nav>
  </div>
</section>

<style>
  .project__back {
    margin-bottom: var(--space-6);
  }

  .project__back a {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
  }

  .project__back a:hover {
    color: var(--color-accent);
  }

  .project__title {
    font-size: 2.25rem;
    margin-bottom: var(--space-4);
  }

  .project__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-surface);
  }

  .project__meta strong {
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-right: var(--space-1);
  }

  .project__desc {
    color: var(--color-text-muted);
    max-width: 56ch;
    margin-bottom: var(--space-6);
  }

  .project__gallery {
    display: grid;
    gap: var(--space-5);
  }

  .project__shot {
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--color-surface);
  }

  .project__shot a {
    display: block;
    cursor: zoom-in;
  }

  .project__shot img {
    width: 100%;
    height: auto;
  }

  .project__nav {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }
</style>
