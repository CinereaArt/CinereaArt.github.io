---
// PortfolioCard — card singola per un lavoro
// Usata nelle griglie e nella home. Il link apre il lightbox o la project page.
interface Props {
  src: string;           // percorso immagine thumbnail
  alt: string;           // alt text descrittivo (SEO + accessibilità)
  title?: string;
  caption?: string;
  href?: string;         // link opzionale (project page)
  fullSrc?: string;      // immagine full per lightbox
}
const { src, alt, title, caption, href, fullSrc } = Astro.props;
const isLink = Boolean(href);
---

{
  isLink ? (
    <a class="card" href={href}>
      <figure class="card__media">
        <img src={src} alt={alt} loading="lazy" decoding="async" width="600" height="600" />
      </figure>
    </a>
  ) : (
    <figure class="card" data-lightbox data-full={fullSrc || src}>
      <a class="card__media" data-lightbox-open href={fullSrc || src} aria-label={`Apri ${alt}`}>
        <img src={src} alt={alt} loading="lazy" decoding="async" width="600" height="600" />
      </a>
    </figure>
  )
}

<style>
  .card {
    display: block;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--color-surface);
  }

  .card__media {
    position: relative;
    display: block;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    cursor: zoom-in;
  }

  .card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-base);
  }

  .card:hover .card__media img {
    transform: scale(1.03);
  }
</style>
