---
// Children's Illustration — griglia masonry + filtri per formato
import BaseLayout from '../../../layouts/BaseLayout.astro';
import WorkGrid from '../../../components/WorkGrid.astro';
import { getCollection } from 'astro:content';

const works = await getCollection('portfolio', ({ data }) =>
  data.category === 'illustration' && data.subcategory === 'children'
);

const mapped = works
  .sort((a, b) => (b.data.date || 0) - (a.data.date || 0))
  .map((w) => ({
    title: w.data.title,
    image: w.data.image || '/images/thumbnails/placeholder.svg',
    fullImage: w.data.imageFull || w.data.image || '/images/portfolio/placeholder.svg',
    slug: w.slug,
    format: 'all',
    tags: [...w.data.tags],
  }));

const filters = [{ value: 'all', label: 'All' }];
---

<BaseLayout title="Children's Illustration" description="Children's illustrations by Agnese Favilla: picture books, covers and stories for children.">
  <WorkGrid
    title="Children’s Illustration"
    description="Illustrations for children: picture books, covers and spot illustrations. A colourful, narrative world for the youngest readers."
    works={mapped}
    filters={filters}
    layout="masonry"
    basePath="/illustration/children/"
  />
</BaseLayout>
