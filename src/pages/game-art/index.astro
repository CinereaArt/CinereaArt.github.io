---
// Game Art & Character Design — griglia 2 colonne + filtri
import BaseLayout from '../../layouts/BaseLayout.astro';
import WorkGrid from '../../components/WorkGrid.astro';
import { getCollection } from 'astro:content';

const works = await getCollection('portfolio', ({ data }) =>
  data.category === 'character-design'
);

const mapped = works.map((w) => ({
  title: w.data.title,
  image: w.data.image || '/images/thumbnails/placeholder.svg',
  fullImage: w.data.imageFull || w.data.image || '/images/portfolio/placeholder.svg',
  slug: w.slug,
  format: w.data.format || 'character-design',
  tags: [...w.data.tags, w.data.format || ''].filter(Boolean),
}));

const filters = [
  { value: 'all', label: 'All' },
  { value: 'character-design', label: 'Character Design' },
  { value: 'environment', label: 'Environment' },
  { value: 'props', label: 'Props & Items' },
  { value: 'process', label: 'Process' },
];
---

<BaseLayout title="Game Art & Character Design" description="Game art and character design by Agnese Favilla for the videogame industry: concept art, characters and environments.">
  <WorkGrid
    title="Game Art &amp; Character Design"
    description="Character design, concept art and environments for the videogame industry. Characters, turnarounds, color explorations and prop design."
    works={mapped}
    filters={filters}
    layout="gameart"
    basePath="/game-art/"
  />
</BaseLayout>
